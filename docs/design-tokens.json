{
  "version": "2.0.0",
  "lastUpdated": "2026-09-24",
  "description": "Design tokens for the Crane Statics QML application, sourced from the BF.DesignSystem module (src/crane_statics/qml_app/design/BF/DesignSystem/). The app is light-mode only: there is no dark variant and no SystemPalette binding. Colors come from the fixed BF/NOV brand palette in Theme.qml; spacing/sizing/radii/breakpoints come from Metrics.qml; font tokens come from Typography.qml.",
  "metadata": {
    "colorSystem": "Fixed BF/NOV brand palette (light-mode only, no theme switching)",
    "module": "BF.DesignSystem",
    "singletons": ["Theme", "Metrics", "Typography"],
    "controls": ["BfButton", "BfTextField", "BfCard", "BfStatusBadge", "BfPage"],
    "fontMetrics": "system-dependent scaling"
  },
  "theme": {
    "description": "Tokens and helper functions from Theme.qml. Values marked \"computed\": true are derived at runtime via Qt.lighter()/Qt.darker()/Theme.contrastText() rather than being a literal hex value; the \"expression\" field shows exactly how.",
    "rawPalette": {
      "novYellow50Tint": "#FFE592",
      "novOrange": "#DC9575",
      "novOrange50Tint": "#F6CDB3",
      "novYellow": "#FFCD00",
      "novPurple50Tint": "#CCC1D4",
      "novRed": "#DA291C",
      "novGrey": "#78757B",
      "novGreen": "#A9C47F",
      "novTeal": "#00A499",
      "novBlue": "#007096",
      "novBrown": "#C6A992",
      "novDarkRed": "#A6093D",
      "novGreen50Tint": "#D4E0BD",
      "novTeal50Tint": "#82CEC9",
      "novBlue50Tint": "#82B4C9",
      "novBrown50Tint": "#E3D2C6",
      "novDarkRed50Tint": "#D18488",
      "novPurple": "#A192B2",
      "black": "#000000",
      "white": "#FFFFFF"
    },
    "colors": {
      "primary": { "value": "#007096", "description": "= novBlue. Active selection, primary actions." },
      "primaryHover": { "computed": true, "expression": "Qt.lighter(novBlue, 112)", "description": "Hover state." },
      "primaryPressed": { "computed": true, "expression": "Qt.darker(novBlue, 115)", "description": "Pressed state." },
      "primaryDisabled": { "computed": true, "expression": "Qt.lighter(novBlue, 170)", "description": "Disabled primary state." },
      "onPrimary": { "value": "#FFFFFF", "description": "= white. Text/icons on a primary fill." },
      "accent": { "value": "#FFCD00", "description": "= novYellow." },
      "accentHover": { "computed": true, "expression": "Qt.lighter(novYellow, 108)" },
      "accentPressed": { "computed": true, "expression": "Qt.darker(novYellow, 110)" },
      "onAccent": { "value": "#000000", "description": "= black. Text/icons on an accent fill." },
      "pageBackground": { "value": "#FFFFFF", "description": "= white. App/page background." },
      "surface": { "value": "#FFFFFF", "description": "= white. Tables, inputs, cards." },
      "surfaceSubtle": { "value": "#CCC1D4", "description": "= novPurple50Tint. Panels, groups, alternate backgrounds." },
      "border": { "value": "#78757B", "description": "= novGrey. Standard border/divider." },
      "borderSubtle": { "value": "#CCC1D4", "description": "= novPurple50Tint. Low-emphasis divider." },
      "text": { "value": "#000000", "description": "= black. Main text." },
      "textMuted": { "value": "#78757B", "description": "= novGrey. Supporting text/labels." },
      "textOnDark": { "value": "#FFFFFF", "description": "= white. Fallback inverse text." },
      "disabledSurface": { "computed": true, "expression": "Qt.lighter(novGrey, 155)" },
      "disabledText": { "computed": true, "expression": "Qt.lighter(novGrey, 120)" },
      "success": { "value": "#A9C47F", "description": "= novGreen." },
      "successSurface": { "value": "#D4E0BD", "description": "= novGreen50Tint. Pastel success fill." },
      "warning": { "value": "#DC9575", "description": "= novOrange." },
      "warningSurface": { "value": "#F6CDB3", "description": "= novOrange50Tint. Pastel warning fill." },
      "error": { "value": "#DA291C", "description": "= novRed." },
      "errorSurface": { "value": "#D18488", "description": "= novDarkRed50Tint. Pastel error fill." },
      "info": { "value": "#00A499", "description": "= novTeal." },
      "infoSurface": { "value": "#82CEC9", "description": "= novTeal50Tint. Pastel info fill." },
      "onSuccess": { "computed": true, "expression": "contrastText(success)", "description": "Whichever of black/white has higher contrast against success." },
      "onWarning": { "computed": true, "expression": "contrastText(warning)" },
      "onError": { "computed": true, "expression": "contrastText(error)" },
      "onInfo": { "computed": true, "expression": "contrastText(info)" },
      "focusRing": { "value": "#007096", "description": "= novBlue. Keyboard focus indicator." },
      "selection": { "value": "#82B4C9", "description": "= novBlue50Tint. Light tint, not a solid fill." },
      "selectionText": { "value": "#000000", "description": "= text (black). Selected text stays the normal dark color since selection is a tint, not an inverse fill." },
      "overlay": { "value": "rgba(0, 0, 0, 0.5)", "description": "Modal/dialog dimming." },
      "shadowColor": { "value": "rgba(0, 0, 0, 0.15)", "description": "Tint for MultiEffect/drop-shadow elevation." }
    },
    "chart": {
      "description": "Chart/scene-canvas semantic colors.",
      "chartCanvasBackground": { "value": "#FFFFFF", "description": "= pageBackground" },
      "chartPlotBackground": { "value": "#FFFFFF", "description": "= surface" },
      "chartGrid": { "computed": true, "expression": "Qt.lighter(novGrey, 160)" },
      "chartAxisText": { "value": "#78757B", "description": "= textMuted" },
      "chartAxisBorder": { "value": "#78757B", "description": "= border" },
      "chartCrosshair": { "value": "#78757B", "description": "= textMuted" },
      "chartTooltipBackground": { "value": "#FFFFFF", "description": "= surface" },
      "chartTooltipBorder": { "value": "#78757B", "description": "= border" },
      "chartTooltipText": { "value": "#000000", "description": "= text" },
      "chartSeriesFallback": { "value": "#78757B", "description": "= textMuted" },
      "chartPass": { "value": "#A9C47F", "description": "= success" },
      "chartFail": { "value": "#DA291C", "description": "= error" },
      "chartPending": { "value": "#DC9575", "description": "= warning" },
      "chartContractual": { "value": "#A9C47F", "description": "= success" }
    },
    "functions": {
      "colorWithAlpha(color, alpha)": "Returns color with the given alpha channel.",
      "relativeLuminance(color)": "WCAG relative luminance of a color.",
      "contrastText(background)": "Returns black or white, whichever has higher WCAG contrast against background.",
      "getSemanticColor(semantic)": "Maps \"success\"|\"warning\"|\"error\"|\"info\"|\"primary\" to its Theme color (default: text).",
      "getOnSemanticColor(semantic)": "Maps \"success\"|\"warning\"|\"error\"|\"info\"|\"primary\" to its contrast-safe on-color (default: textOnDark).",
      "getStatusColor(level)": "Numeric 0.0-1.0 stress level -> success (<0.4) | warning (<0.7) | error (>=0.7)."
    }
  },
  "metrics": {
    "description": "Tokens from Metrics.qml. Flat numeric scale; there are no grouped/semantic aliases like the old spacing.md or spacing.panelPadding.",
    "spacing": {
      "spacing2": 2,
      "spacing4": 4,
      "spacing6": 6,
      "spacing8": 8,
      "spacing12": 12,
      "spacing16": 16,
      "spacing24": 24,
      "spacing32": 32,
      "spacing48": 48
    },
    "controls": {
      "controlHeight": 36,
      "compactControlHeight": 30,
      "buttonMinWidth": 96,
      "fieldMinWidth": 160,
      "minInputWidth": 60,
      "maxInputWidth": 200,
      "dialogWidth": 480
    },
    "rows": {
      "tableRowHeight": 28,
      "compactRowHeight": 24
    },
    "icons": {
      "iconSmall": 16,
      "iconNormal": 24,
      "iconLarge": 32,
      "iconXLarge": 48
    },
    "bordersAndRadii": {
      "radiusSmall": 3,
      "radiusMedium": 5,
      "radiusLarge": 8,
      "borderWidth": 1,
      "borderWidthNormal": 2,
      "focusWidth": 2
    },
    "controlFontSizes": {
      "description": "Internal font-size scale used by the Bf* controls' own chrome (distinct from the Typography singleton's general-purpose scale).",
      "fontSizeSmall": 12,
      "fontSizeBody": 14,
      "fontSizeSubtitle": 16,
      "fontSizeTitle": 22
    },
    "transitions": {
      "transitionFast": 100,
      "transitionNormal": 200,
      "transitionSlow": 300
    },
    "breakpoints": {
      "breakpointCompact": { "value": 1240, "description": "Width < 1240px -> 1-column layout (stacked panels)" },
      "breakpointUltraWide": { "value": 1800, "description": "Width >= 1800px -> data-dense table layouts" }
    },
    "spacingMultiplier": 1.0
  },
  "typography": {
    "description": "Tokens from Typography.qml. This is the general-purpose type scale for app content (distinct from Metrics.controlFontSizes, which the Bf* controls use for their own internal chrome).",
    "fontFamily": {
      "sans": "Segoe UI, Ubuntu, 'Liberation Sans', sans-serif",
      "mono": "'Consolas', 'Monaco', 'Courier New', monospace"
    },
    "weights": {
      "weightLight": 300,
      "weightRegular": 400,
      "weightMedium": 500,
      "weightSemiBold": 600,
      "weightBold": 700
    },
    "sizes": {
      "caption": { "value": 11, "description": "Small labels, help text", "usage": "Form hints, table captions" },
      "body": { "value": 13, "description": "Body text, default", "usage": "Standard paragraph text, table cells, inputs" },
      "bodyLarge": { "value": 14, "description": "Larger body text", "usage": "Important body text, data summary" },
      "subtitle": { "value": 14, "description": "Subtitles, secondary headings", "usage": "Subsection titles, group labels" },
      "heading": { "value": 16, "description": "Section headings", "usage": "Dialog titles, panel headers" },
      "headingLarge": { "value": 18, "description": "Major headings, titles", "usage": "Workspace titles, major section headers" },
      "display": { "value": 22, "description": "Large display titles", "usage": "Application title" }
    },
    "lineHeight": {
      "lineHeightTight": 1.2,
      "lineHeightNormal": 1.5,
      "lineHeightRelaxed": 1.8
    },
    "letterSpacing": {
      "letterSpacingNormal": 0,
      "letterSpacingWide": 0.5
    }
  },
  "semanticColorGuide": {
    "description": "Guidance on when to use each semantic color role",
    "primary": "Primary actions, active selections, links. Use for main call-to-action buttons and currently selected items.",
    "success": "Validation success, safe states. Use for checkmarks, 'valid' indicators, 'OK' confirmations.",
    "warning": "Caution states, non-critical alerts. Use for warnings that require user attention but are not errors.",
    "error": "Errors, invalid states. Use for form errors, failed operations, critical alerts.",
    "info": "Informational messages, hints. Use for tooltips, help text, information alerts.",
    "textMuted": "Supporting text, less important information. Use for form labels, captions, sub-text.",
    "disabledText": "Disabled controls. Use for inactive buttons, disabled form fields, unavailable actions."
  },
  "craneEngineeringColorScale": {
    "description": "Color scale for crane loading analysis (maps numeric stress levels 0-1 to visual feedback), via Theme.getStatusColor(level)",
    "0.0_to_0.4": "#A9C47F (novGreen/Success) - Safe operating range",
    "0.4_to_0.7": "#DC9575 (novOrange/Warning) - Caution range, approaching limits",
    "0.7_to_1.0": "#DA291C (novRed/Error) - Overload/critical range"
  }
}

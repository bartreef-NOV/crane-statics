{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/crane-statics-v5.13.schema.json",
  "title": "Crane Statics Authored Input v5.13",
  "description": "Minimal authored input for a fixed-topology 2D crane. Coordinates are named objects; lengths are metres, masses are tonnes, and angles are degrees unless noted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "metadata", "model_definition"],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "crane-statics" },
        "version": { "const": "5.13.0" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "model_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "boom_width_m", "slewing_bearing_diameter_m", "boom_heel", "upper_hinge", "rear_hinge", "front_hinge", "boom", "rear_leg", "front_leg", "platform", "boom_hoist", "payload_hoists"],
      "properties": {
        "environment": { "$ref": "#/$defs/Environment" },
        "vessel_motion": { "$ref": "#/$defs/VesselMotion", "default": {} },
        "hook_height_at_min_outreach_m": { "type": "number", "description": "Absolute global Z the hook must reach at each payload hoist's minimum outreach. Every payload hoist's maximum hook travel and total rope length are derived from it. Omit to default to environment.mean_sealevel_z_m." },
        "boom_width_m": { "type": "number", "exclusiveMinimum": 0 },
        "slewing_bearing_diameter_m": { "type": "number", "exclusiveMinimum": 0 },
        "boom_heel": { "$ref": "#/$defs/GlobalPosition2D" },
        "upper_hinge": { "$ref": "#/$defs/GlobalPosition2D" },
        "rear_hinge": { "$ref": "#/$defs/GlobalPosition2D" },
        "front_hinge": { "$ref": "#/$defs/GlobalPosition2D" },
        "boom": { "$ref": "#/$defs/BoomBody" },
        "rear_leg": { "$ref": "#/$defs/GlobalBody" },
        "front_leg": { "$ref": "#/$defs/GlobalBody" },
        "platform": { "$ref": "#/$defs/GlobalBody" },
        "boom_hoist": { "$ref": "#/$defs/BoomHoist" },
        "payload_hoists": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/IdName" },
          "additionalProperties": { "$ref": "#/$defs/PayloadHoist" }
        }
      }
    }
  },
  "$defs": {
    "IdName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "GlobalPosition2D": {
      "type": "object",
      "description": "Global X/Z position in metres.",
      "examples": [{ "x_m": 0.0, "z_m": 7.7 }],
      "additionalProperties": false,
      "required": ["x_m", "z_m"],
      "properties": {
        "x_m": { "type": "number", "description": "Global horizontal coordinate in metres." },
        "z_m": { "type": "number", "description": "Global vertical coordinate in metres." }
      }
    },
    "GlobalPosition3D": {
      "type": "object",
      "description": "Global X/Y/Z position in metres.",
      "examples": [{ "x_m": 0.0, "y_m": 0.0, "z_m": 4.0 }],
      "additionalProperties": false,
      "required": ["x_m", "y_m", "z_m"],
      "properties": {
        "x_m": { "type": "number", "description": "Global horizontal coordinate in metres." },
        "y_m": { "type": "number", "description": "Global transverse coordinate in metres." },
        "z_m": { "type": "number", "description": "Global vertical coordinate in metres." }
      }
    },
    "BoomPosition3D": {
      "type": "object",
      "description": "Boom-local U/V/W position in metres.",
      "examples": [{ "u_m": 87.0, "v_m": 0.0, "w_m": -0.4 }],
      "additionalProperties": false,
      "required": ["u_m", "v_m", "w_m"],
      "properties": {
        "u_m": { "type": "number", "description": "Boom-local longitudinal coordinate in metres." },
        "v_m": { "type": "number", "description": "Boom-local transverse coordinate in metres." },
        "w_m": { "type": "number", "description": "Boom-local vertical coordinate in metres." }
      }
    },
    "BoomPosition2D": {
      "type": "object",
      "description": "Boom-local U/W position in metres.",
      "examples": [{ "u_m": 155.0, "w_m": -6.05 }],
      "additionalProperties": false,
      "required": ["u_m", "w_m"],
      "properties": {
        "u_m": { "type": "number", "description": "Boom-local longitudinal coordinate in metres." },
        "w_m": { "type": "number", "description": "Boom-local vertical coordinate in metres." }
      }
    },
    "Environment": {
      "type": "object",
      "description": "Environmental constants. Gravity and air density have defaults; wind profile and sea-level reference values are required.",
      "additionalProperties": false,
      "required": ["max_wind_speed_m_s", "wind_profile_exponent", "wind_reference_height_m_asl", "mean_sealevel_z_m"],
      "properties": {
        "gravity_m_s2": { "type": "number", "exclusiveMinimum": 0, "default": 9.81, "description": "Gravity magnitude in m/s²; the runtime uses it as negative Z gravity." },
        "max_wind_speed_m_s": { "type": "number", "exclusiveMinimum": 0, "description": "Positive maximum wind speed in m/s." },
        "air_density_kg_m3": { "type": "number", "exclusiveMinimum": 0, "default": 1.225 },
        "wind_profile_exponent": { "type": "number", "exclusiveMinimum": 0, "description": "Power-law wind profile exponent." },
        "wind_reference_height_m_asl": { "type": "number", "exclusiveMinimum": 0, "description": "Reference height above mean sea level in metres." },
        "mean_sealevel_z_m": { "type": "number", "description": "Mean sea-level elevation in global Z metres." }
      }
    },
    "VesselMotion": {
      "type": "object",
      "description": "Optional vessel accelerations and rotation reference. Omitted values default to zero.",
      "additionalProperties": false,
      "properties": {
        "accel_x_m_s2": { "type": "number", "minimum": 0, "default": 0 },
        "accel_y_m_s2": { "type": "number", "minimum": 0, "default": 0 },
        "accel_z_m_s2": { "type": "number", "minimum": 0, "default": 0 },
        "pitch_angular_accel_rad_s2": { "type": "number", "minimum": 0, "default": 0 },
        "roll_angular_accel_rad_s2": { "type": "number", "minimum": 0, "default": 0 },
        "reference_x_m": { "type": "number", "default": 0 },
        "reference_z_m": { "type": "number", "default": 0 }
      }
    },
    "MassPointBoom": {
      "type": "object",
      "description": "Boom structural mass located in boom-local U/V/W coordinates.",
      "examples": [{ "id": "boom_structure", "mass_t": 759.1, "position": { "u_m": 87.0, "v_m": 0.0, "w_m": -0.4 } }],
      "additionalProperties": false,
      "required": ["id", "mass_t", "position"],
      "properties": {
        "id": { "$ref": "#/$defs/IdName" },
        "mass_t": { "type": "number", "exclusiveMinimum": 0 },
        "position": { "$ref": "#/$defs/BoomPosition3D" }
      }
    },
    "MassPointGlobal": {
      "type": "object",
      "description": "Fixed-body mass located in global X/Y/Z coordinates.",
      "examples": [{ "id": "platform_structure", "mass_t": 615.0, "position": { "x_m": -0.49, "y_m": 0.23, "z_m": 4.24 } }],
      "additionalProperties": false,
      "required": ["id", "mass_t", "position"],
      "properties": {
        "id": { "$ref": "#/$defs/IdName" },
        "mass_t": { "type": "number", "exclusiveMinimum": 0 },
        "position": { "$ref": "#/$defs/GlobalPosition3D" }
      }
    },
    "WindAreaBoom": {
      "type": "object",
      "description": "Boom wind area using boom-local U/W centroid coordinates.",
      "examples": [{ "id": "boom_lattice", "area_w_m2": 540.3, "area_v_m2": 485.7, "cd": 1.25, "position": { "u_m": 82.4, "w_m": 0.0 } }],
      "additionalProperties": false,
      "required": ["id", "area_w_m2", "area_v_m2", "cd", "position"],
      "properties": {
        "id": { "$ref": "#/$defs/IdName" },
        "area_w_m2": { "type": "number", "minimum": 0 },
        "area_v_m2": { "type": "number", "minimum": 0 },
        "cd": { "type": "number", "exclusiveMinimum": 0, "default": 1 },
        "position": { "$ref": "#/$defs/BoomPosition2D" }
      }
    },
    "WindAreaGlobal": {
      "type": "object",
      "description": "Fixed-body wind area using global X/Z centroid coordinates.",
      "examples": [{ "id": "platform_wind_x", "area_x_m2": 156.5, "area_y_m2": 0.0, "cd": 1.0, "position": { "x_m": 0.0, "z_m": 3.4 } }],
      "additionalProperties": false,
      "required": ["id", "area_x_m2", "area_y_m2", "cd", "position"],
      "properties": {
        "id": { "$ref": "#/$defs/IdName" },
        "area_x_m2": { "type": "number", "minimum": 0 },
        "area_y_m2": { "type": "number", "minimum": 0 },
        "cd": { "type": "number", "exclusiveMinimum": 0, "default": 1 },
        "position": { "$ref": "#/$defs/GlobalPosition2D" }
      }
    },
    "BoomBody": {
      "type": "object",
      "description": "Optional boom mass, wind, and named boom-local nodes. Rope-referenced node IDs must be present.",
      "additionalProperties": false,
      "properties": {
        "mass_points": { "type": "array", "items": { "$ref": "#/$defs/MassPointBoom" }, "default": [] },
        "wind_areas": { "type": "array", "items": { "$ref": "#/$defs/WindAreaBoom" }, "default": [] },
        "nodes": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/IdName" },
          "additionalProperties": { "$ref": "#/$defs/BoomPosition2D" },
          "default": {}
        }
      }
    },
    "GlobalBody": {
      "type": "object",
      "description": "Optional fixed-body mass, wind, and named global nodes. Rope-referenced node IDs must be present.",
      "additionalProperties": false,
      "properties": {
        "mass_points": { "type": "array", "items": { "$ref": "#/$defs/MassPointGlobal" }, "default": [] },
        "wind_areas": { "type": "array", "items": { "$ref": "#/$defs/WindAreaGlobal" }, "default": [] },
        "nodes": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/IdName" },
          "additionalProperties": { "$ref": "#/$defs/GlobalPosition2D" },
          "default": {}
        }
      }
    },
    "RopeSegment": {
      "type": "object",
      "description": "One connected rope path segment. Node IDs must refer to nodes in the model.",
      "examples": [{ "from": "winch", "to": "sheave", "parts": 2 }],
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/IdName", "description": "Starting node ID." },
        "to": { "$ref": "#/$defs/IdName", "description": "Ending node ID." },
        "parts": { "type": "integer", "minimum": 1, "default": 1 }
      }
    },
    "ContractualPoint": {
      "type": "object",
      "description": "A rated operating point on the hoist capacity curve.",
      "examples": [{ "outreach_m": 50.0, "load_t": 1433.0 }],
      "additionalProperties": false,
      "required": ["outreach_m", "load_t"],
      "properties": {
        "outreach_m": { "type": "number", "minimum": 0, "description": "Horizontal outreach in metres." },
        "load_t": { "type": "number", "minimum": 0, "description": "Permitted payload in tonnes." }
      }
    },
    "BoomHoist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rope_segments"],
      "properties": {
        "rope_segments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/RopeSegment" } },
        "linear_mass_kg_m": { "type": "number", "minimum": 0, "default": 0 },
        "rope_length_m": { "type": "number", "minimum": 0, "description": "Total rope length in metres. Omit to leave the length on the drum unknown, in which case no spooled rope mass is reported for this hoist." }
      }
    },
    "PayloadHoistMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["falls", "hook_mass_t", "contractual_points"],
      "properties": {
        "falls": { "type": "integer", "minimum": 1 },
        "hook_mass_t": { "type": "number", "minimum": 0 },
        "contractual_points": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ContractualPoint" } }
      }
    },
    "PayloadHoist": {
      "type": "object",
      "description": "Payload hoist attached to a named support node. The application creates the managed hook node automatically.",
      "examples": [{ "support_node_id": "mh_boom_sheave_4", "hook_daf": 1.1, "offlead_deg": 1.0, "falls": 20, "hook_mass_t": 102.0, "contractual_points": [{ "outreach_m": 50.0, "load_t": 1433.0 }], "rope_segments": [{ "from": "winch", "to": "sheave", "parts": 2 }] }],
      "additionalProperties": false,
      "required": ["rope_segments", "support_node_id", "hook_daf", "offlead_deg", "falls", "hook_mass_t", "contractual_points"],
      "dependentRequired": { "drum_dead_turns": ["drum_diameter_m"] },
      "properties": {
        "rope_segments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/RopeSegment" } },
        "linear_mass_kg_m": { "type": "number", "minimum": 0, "default": 0 },
        "support_node_id": { "$ref": "#/$defs/IdName" },
        "hook_daf": { "type": "number", "minimum": 1 },
        "offlead_deg": { "type": "number", "minimum": 0 },
        "sidelead_deg": { "type": "number", "minimum": 0, "default": 0 },
        "drum_dead_turns": { "type": "integer", "minimum": 0, "default": 0, "description": "Turns of rope that must remain on the drum when the hook is at its lowest point. Requires drum_diameter_m." },
        "drum_diameter_m": { "type": "number", "exclusiveMinimum": 0, "description": "Mean wrap diameter of the dead turns in metres. Dead rope length is drum_dead_turns * pi * drum_diameter_m and is added to the derived total rope length." },
        "falls": { "type": "integer", "minimum": 1 },
        "hook_mass_t": { "type": "number", "minimum": 0 },
        "contractual_points": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ContractualPoint" } },
        "split": { "$ref": "#/$defs/PayloadHoistMode" }
      }
    }
  }
}

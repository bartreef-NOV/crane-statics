{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/crane-statics-v7.schema.json",
  "title": "AuthoredDocument",
  "$defs": {
    "AuthoredBoomBody": {
      "additionalProperties": false,
      "description": "Optional boom mass, wind, and named boom-local nodes. Rope-referenced\nnode IDs must be present.",
      "properties": {
        "mass_points": {
          "items": {
            "$ref": "#/$defs/AuthoredMassPointBoom"
          },
          "title": "Mass Points",
          "type": "array"
        },
        "wind_areas": {
          "items": {
            "$ref": "#/$defs/AuthoredWindAreaBoom"
          },
          "title": "Wind Areas",
          "type": "array"
        },
        "nodes": {
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_-]*$": {
              "$ref": "#/$defs/AuthoredBoomPosition2D"
            }
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Nodes",
          "type": "object"
        }
      },
      "title": "AuthoredBoomBody",
      "type": "object"
    },
    "AuthoredBoomHoist": {
      "additionalProperties": false,
      "description": "The rope system that luffs the boom. Its hoist-local node IDs are prefixed ``bh_``.",
      "properties": {
        "rope": {
          "$ref": "#/$defs/AuthoredBoomHoistRope"
        },
        "reeving": {
          "items": {
            "$ref": "#/$defs/AuthoredReevingEntry"
          },
          "minItems": 2,
          "title": "Reeving",
          "type": "array"
        }
      },
      "required": [
        "reeving"
      ],
      "title": "AuthoredBoomHoist",
      "type": "object"
    },
    "AuthoredBoomHoistRope": {
      "additionalProperties": false,
      "properties": {
        "linear_mass_kg_m": {
          "default": 0.0,
          "minimum": 0,
          "title": "Linear Mass Kg M",
          "type": "number"
        },
        "length_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Total rope length in metres. Omit to leave the length on the drum unknown, in which case no spooled rope mass is reported for this hoist.",
          "title": "Length M"
        }
      },
      "title": "AuthoredBoomHoistRope",
      "type": "object"
    },
    "AuthoredBoomPosition2D": {
      "additionalProperties": false,
      "description": "Boom-local U/W position in metres.",
      "examples": [
        {
          "u_m": 155.0,
          "w_m": -6.05
        }
      ],
      "properties": {
        "u_m": {
          "description": "Boom-local longitudinal coordinate in metres.",
          "title": "U M",
          "type": "number"
        },
        "w_m": {
          "description": "Boom-local vertical coordinate in metres.",
          "title": "W M",
          "type": "number"
        }
      },
      "required": [
        "u_m",
        "w_m"
      ],
      "title": "AuthoredBoomPosition2D",
      "type": "object"
    },
    "AuthoredBoomPosition3D": {
      "additionalProperties": false,
      "description": "Boom-local U/V/W position in metres.",
      "examples": [
        {
          "u_m": 87.0,
          "v_m": 0.0,
          "w_m": -0.4
        }
      ],
      "properties": {
        "u_m": {
          "description": "Boom-local longitudinal coordinate in metres.",
          "title": "U M",
          "type": "number"
        },
        "v_m": {
          "description": "Boom-local transverse coordinate in metres.",
          "title": "V M",
          "type": "number"
        },
        "w_m": {
          "description": "Boom-local vertical coordinate in metres.",
          "title": "W M",
          "type": "number"
        }
      },
      "required": [
        "u_m",
        "v_m",
        "w_m"
      ],
      "title": "AuthoredBoomPosition3D",
      "type": "object"
    },
    "AuthoredEnvironment": {
      "additionalProperties": false,
      "description": "Environmental constants. Gravity and air density have defaults; the maximum\nwind speed (constant over height) is required.",
      "properties": {
        "gravity_m_s2": {
          "default": 9.81,
          "description": "Gravity magnitude in m/s\u00b2; the runtime uses it as negative Z gravity.",
          "exclusiveMinimum": 0,
          "title": "Gravity M S2",
          "type": "number"
        },
        "max_wind_speed_m_s": {
          "description": "Positive maximum wind speed in m/s.",
          "exclusiveMinimum": 0,
          "title": "Max Wind Speed M S",
          "type": "number"
        },
        "air_density_kg_m3": {
          "default": 1.225,
          "exclusiveMinimum": 0,
          "title": "Air Density Kg M3",
          "type": "number"
        }
      },
      "required": [
        "max_wind_speed_m_s"
      ],
      "title": "AuthoredEnvironment",
      "type": "object"
    },
    "AuthoredGlobalBody": {
      "additionalProperties": false,
      "description": "Optional fixed-body mass, wind, and named global nodes. Rope-referenced\nnode IDs must be present.",
      "properties": {
        "mass_points": {
          "items": {
            "$ref": "#/$defs/AuthoredMassPointGlobal"
          },
          "title": "Mass Points",
          "type": "array"
        },
        "wind_areas": {
          "items": {
            "$ref": "#/$defs/AuthoredWindAreaGlobal"
          },
          "title": "Wind Areas",
          "type": "array"
        },
        "nodes": {
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_-]*$": {
              "$ref": "#/$defs/AuthoredGlobalPosition2D"
            }
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Nodes",
          "type": "object"
        }
      },
      "title": "AuthoredGlobalBody",
      "type": "object"
    },
    "AuthoredGlobalPosition2D": {
      "additionalProperties": false,
      "description": "Global X/Z position in metres.",
      "examples": [
        {
          "x_m": 0.0,
          "z_m": 7.7
        }
      ],
      "properties": {
        "x_m": {
          "description": "Global horizontal coordinate in metres.",
          "title": "X M",
          "type": "number"
        },
        "z_m": {
          "description": "Global vertical coordinate in metres.",
          "title": "Z M",
          "type": "number"
        }
      },
      "required": [
        "x_m",
        "z_m"
      ],
      "title": "AuthoredGlobalPosition2D",
      "type": "object"
    },
    "AuthoredGlobalPosition3D": {
      "additionalProperties": false,
      "description": "Global X/Y/Z position in metres.",
      "examples": [
        {
          "x_m": 0.0,
          "y_m": 0.0,
          "z_m": 4.0
        }
      ],
      "properties": {
        "x_m": {
          "description": "Global horizontal coordinate in metres.",
          "title": "X M",
          "type": "number"
        },
        "y_m": {
          "description": "Global transverse coordinate in metres.",
          "title": "Y M",
          "type": "number"
        },
        "z_m": {
          "description": "Global vertical coordinate in metres.",
          "title": "Z M",
          "type": "number"
        }
      },
      "required": [
        "x_m",
        "y_m",
        "z_m"
      ],
      "title": "AuthoredGlobalPosition3D",
      "type": "object"
    },
    "AuthoredHook": {
      "additionalProperties": false,
      "properties": {
        "mass_t": {
          "minimum": 0,
          "title": "Mass T",
          "type": "number"
        },
        "falls": {
          "description": "Rope falls between the support sheave and the hook.",
          "minimum": 1,
          "title": "Falls",
          "type": "integer"
        },
        "daf": {
          "description": "Hook dynamic amplification factor.",
          "minimum": 1,
          "title": "Daf",
          "type": "number"
        },
        "offlead_deg": {
          "minimum": 0,
          "title": "Offlead Deg",
          "type": "number"
        },
        "sidelead_deg": {
          "default": 0.0,
          "minimum": 0,
          "title": "Sidelead Deg",
          "type": "number"
        }
      },
      "required": [
        "mass_t",
        "falls",
        "daf",
        "offlead_deg"
      ],
      "title": "AuthoredHook",
      "type": "object"
    },
    "AuthoredLoadChartPoint": {
      "additionalProperties": false,
      "description": "A rated operating point on the hoist capacity curve.",
      "examples": [
        {
          "load_t": 1433.0,
          "outreach_m": 50.0
        }
      ],
      "properties": {
        "outreach_m": {
          "description": "Horizontal outreach in metres.",
          "minimum": 0,
          "title": "Outreach M",
          "type": "number"
        },
        "load_t": {
          "description": "Permitted payload in tonnes.",
          "minimum": 0,
          "title": "Load T",
          "type": "number"
        }
      },
      "required": [
        "outreach_m",
        "load_t"
      ],
      "title": "AuthoredLoadChartPoint",
      "type": "object"
    },
    "AuthoredMassPointBoom": {
      "additionalProperties": false,
      "description": "Boom structural mass located in boom-local U/V/W coordinates.",
      "examples": [
        {
          "id": "boom_structure",
          "mass_t": 759.1,
          "position": {
            "u_m": 87.0,
            "v_m": 0.0,
            "w_m": -0.4
          }
        }
      ],
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "mass_t": {
          "exclusiveMinimum": 0,
          "title": "Mass T",
          "type": "number"
        },
        "position": {
          "$ref": "#/$defs/AuthoredBoomPosition3D"
        }
      },
      "required": [
        "id",
        "mass_t",
        "position"
      ],
      "title": "AuthoredMassPointBoom",
      "type": "object"
    },
    "AuthoredMassPointGlobal": {
      "additionalProperties": false,
      "description": "Fixed-body mass located in global X/Y/Z coordinates.",
      "examples": [
        {
          "id": "platform_structure",
          "mass_t": 615.0,
          "position": {
            "x_m": -0.49,
            "y_m": 0.23,
            "z_m": 4.24
          }
        }
      ],
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "mass_t": {
          "exclusiveMinimum": 0,
          "title": "Mass T",
          "type": "number"
        },
        "position": {
          "$ref": "#/$defs/AuthoredGlobalPosition3D"
        }
      },
      "required": [
        "id",
        "mass_t",
        "position"
      ],
      "title": "AuthoredMassPointGlobal",
      "type": "object"
    },
    "AuthoredMetadata": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "name"
      ],
      "title": "AuthoredMetadata",
      "type": "object"
    },
    "AuthoredModelDefinition": {
      "additionalProperties": false,
      "properties": {
        "environment": {
          "$ref": "#/$defs/AuthoredEnvironment"
        },
        "vessel_motion": {
          "$ref": "#/$defs/AuthoredVesselMotion"
        },
        "hook_height_at_min_outreach_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Absolute global Z the hook must reach at each payload hoist's minimum outreach. Every payload hoist's maximum hook travel and total rope length are derived from it. Omit to default to crane-frame z = 0.",
          "title": "Hook Height At Min Outreach M"
        },
        "structure": {
          "$ref": "#/$defs/AuthoredStructure"
        },
        "boom": {
          "$ref": "#/$defs/AuthoredBoomBody",
          "description": "The boom body: its structural mass, wind areas, and shared boom-local nodes. Hoist sheaves belong in each hoist's reeving."
        },
        "rear_leg": {
          "$ref": "#/$defs/AuthoredGlobalBody",
          "description": "The rear leg body supporting the upper structure, in global coordinates."
        },
        "front_leg": {
          "$ref": "#/$defs/AuthoredGlobalBody",
          "description": "The front leg body supporting the upper structure, in global coordinates."
        },
        "platform": {
          "$ref": "#/$defs/AuthoredGlobalBody",
          "description": "The fixed platform/base body, in global coordinates."
        },
        "boom_hoist": {
          "$ref": "#/$defs/AuthoredBoomHoist",
          "description": "The rope system that raises and lowers the boom."
        },
        "payload_hoists": {
          "description": "Named payload hoists. Each is self-contained: deleting its block removes the hoist together with the sheaves it owns.",
          "minProperties": 1,
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_-]*$": {
              "$ref": "#/$defs/AuthoredPayloadHoist"
            }
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Payload Hoists",
          "type": "object"
        }
      },
      "required": [
        "environment",
        "structure",
        "boom_hoist",
        "payload_hoists"
      ],
      "title": "AuthoredModelDefinition",
      "type": "object"
    },
    "AuthoredPayloadHoist": {
      "additionalProperties": false,
      "description": "Self-contained payload hoist: its rope, its reeving path with the sheaves it\nowns, its hook block and its load chart. The hook hangs from the last reeving\nnode unless support_node names another; the application creates the managed\nhook node automatically.",
      "examples": [
        {
          "hook": {
            "daf": 1.1,
            "falls": 20,
            "mass_t": 50.0,
            "offlead_deg": 1.0
          },
          "load_chart": [
            {
              "load_t": 1000.0,
              "outreach_m": 16.0
            }
          ],
          "reeving": [
            {
              "body": "platform",
              "node": "winch",
              "x_m": 1.81,
              "z_m": 3.99
            },
            {
              "body": "boom",
              "node": "boom_sheave_4",
              "parts": 2,
              "u_m": 109.0,
              "w_m": -4.25
            }
          ],
          "rope": {
            "linear_mass_kg_m": 9.17
          }
        }
      ],
      "properties": {
        "rope": {
          "$ref": "#/$defs/AuthoredPayloadHoistRope"
        },
        "reeving": {
          "items": {
            "$ref": "#/$defs/AuthoredReevingEntry"
          },
          "minItems": 2,
          "title": "Reeving",
          "type": "array"
        },
        "support_node": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reeving node the hook hangs from. Omit to use the last reeving entry.",
          "title": "Support Node"
        },
        "hook": {
          "$ref": "#/$defs/AuthoredHook"
        },
        "load_chart": {
          "items": {
            "$ref": "#/$defs/AuthoredLoadChartPoint"
          },
          "minItems": 1,
          "title": "Load Chart",
          "type": "array"
        },
        "split": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuthoredSplitMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "reeving",
        "hook",
        "load_chart"
      ],
      "title": "AuthoredPayloadHoist",
      "type": "object"
    },
    "AuthoredPayloadHoistRope": {
      "additionalProperties": false,
      "properties": {
        "linear_mass_kg_m": {
          "default": 0.0,
          "minimum": 0,
          "title": "Linear Mass Kg M",
          "type": "number"
        },
        "drum_dead_turns": {
          "default": 0,
          "description": "Turns of rope that must remain on the drum when the hook is at its lowest point. Requires drum_diameter_m.",
          "minimum": 0,
          "title": "Drum Dead Turns",
          "type": "integer"
        },
        "drum_diameter_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mean wrap diameter of the dead turns in metres. Dead rope length is drum_dead_turns * pi * drum_diameter_m and is added to the derived total rope length.",
          "title": "Drum Diameter M"
        }
      },
      "title": "AuthoredPayloadHoistRope",
      "type": "object"
    },
    "AuthoredReevingEntry": {
      "additionalProperties": false,
      "description": "One stop on a hoist's rope path, listed in order from the winch outwards.\n\nAn entry carrying ``body`` and coordinates defines a node owned by this hoist;\nits global ID is the lowercased hoist ID, an underscore, and ``node``. An entry\nwithout coordinates passes through a node by name: another node of this hoist\nif one is so named, otherwise a global node (a primary node such as\n``boom_heel`` or a shared node listed under a body's ``nodes``).",
      "examples": [
        {
          "body": "platform",
          "node": "winch",
          "x_m": 1.81,
          "z_m": 3.99
        },
        {
          "body": "boom",
          "node": "boom_sheave_4",
          "parts": 2,
          "u_m": 109.0,
          "w_m": -4.25
        }
      ],
      "properties": {
        "node": {
          "description": "Node name, local to this hoist unless it reuses a node.",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "title": "Node",
          "type": "string"
        },
        "body": {
          "anyOf": [
            {
              "enum": [
                "boom",
                "rear_leg",
                "front_leg",
                "platform"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Body the node moves with. Boom nodes use u_m/w_m; the others use x_m/z_m. Omit (with all coordinates) to pass through an existing node.",
          "title": "Body"
        },
        "u_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Boom-local longitudinal coordinate.",
          "title": "U M"
        },
        "w_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Boom-local vertical coordinate.",
          "title": "W M"
        },
        "x_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Global horizontal coordinate.",
          "title": "X M"
        },
        "z_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Global vertical coordinate.",
          "title": "Z M"
        },
        "parts": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rope parts in the span arriving at this node (default 1). Not allowed on the first entry.",
          "title": "Parts"
        },
        "from": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Node the span arriving here starts from, when it is not the previous entry. Not allowed on the first entry.",
          "title": "From"
        }
      },
      "required": [
        "node"
      ],
      "title": "AuthoredReevingEntry",
      "type": "object"
    },
    "AuthoredSchemaBlock": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "crane-statics",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^7\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "AuthoredSchemaBlock",
      "type": "object"
    },
    "AuthoredSplitHook": {
      "additionalProperties": false,
      "properties": {
        "mass_t": {
          "minimum": 0,
          "title": "Mass T",
          "type": "number"
        },
        "falls": {
          "minimum": 1,
          "title": "Falls",
          "type": "integer"
        }
      },
      "required": [
        "mass_t",
        "falls"
      ],
      "title": "AuthoredSplitHook",
      "type": "object"
    },
    "AuthoredSplitMode": {
      "additionalProperties": false,
      "description": "Optional split-block operating mode with its own hook block and load chart.",
      "properties": {
        "hook": {
          "$ref": "#/$defs/AuthoredSplitHook"
        },
        "load_chart": {
          "items": {
            "$ref": "#/$defs/AuthoredLoadChartPoint"
          },
          "minItems": 1,
          "title": "Load Chart",
          "type": "array"
        }
      },
      "required": [
        "hook",
        "load_chart"
      ],
      "title": "AuthoredSplitMode",
      "type": "object"
    },
    "AuthoredStructure": {
      "additionalProperties": false,
      "description": "Primary structure geometry: the boom heel, the hinges and support widths.",
      "properties": {
        "boom_width_m": {
          "description": "Boom structural width in metres, used for platform-base bearing line load checks.",
          "exclusiveMinimum": 0,
          "title": "Boom Width M",
          "type": "number"
        },
        "slewing_bearing_diameter_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Slewing bearing diameter. Omit to skip platform-base bearing line load checks.",
          "title": "Slewing Bearing Diameter M"
        },
        "boom_heel": {
          "$ref": "#/$defs/AuthoredGlobalPosition2D",
          "description": "Global position of the boom's heel (foot) pivot."
        },
        "upper_hinge": {
          "$ref": "#/$defs/AuthoredGlobalPosition2D",
          "description": "Global position of the upper structure hinge the boom is suspended from."
        },
        "rear_hinge": {
          "$ref": "#/$defs/AuthoredGlobalPosition2D",
          "description": "Global position of the rear leg's upper hinge."
        },
        "front_hinge": {
          "$ref": "#/$defs/AuthoredGlobalPosition2D",
          "description": "Global position of the front leg's upper hinge."
        }
      },
      "required": [
        "boom_width_m",
        "boom_heel",
        "upper_hinge",
